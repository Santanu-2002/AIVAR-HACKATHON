package com.aivar.qa.controller;

import com.aivar.qa.model.QaReport;
import com.aivar.qa.model.QaRequest;
import com.aivar.qa.orchestrator.QaOrchestrator;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/qa")
@CrossOrigin(origins = "*")
public class QaController {

    private final QaOrchestrator orchestrator;

    public QaController(
            QaOrchestrator orchestrator) {

        this.orchestrator =
                orchestrator;
    }

    @PostMapping("/run")
    public ResponseEntity<QaReport> run(
            @RequestBody QaRequest request)
            throws Exception {

        QaReport report =
                orchestrator.run(
                        request.getUrl(),
                        request.getIntent()
                );

        return ResponseEntity.ok(
                report
        );
    }
}
